
##### B1.1 FLOWTABLE (the big question: does offload bypass my counters?) #####
-- firewall defaults --
firewall.cfg01e63d=defaults
firewall.cfg01e63d.input='REJECT'
firewall.cfg01e63d.output='ACCEPT'
firewall.cfg01e63d.forward='REJECT'
firewall.cfg01e63d.synflood_protect='1'
firewall.cfg01e63d.flow_offloading='1'
firewall.cfg01e63d.flow_offloading_hw='1'
flow_offloading    = 1
flow_offloading_hw = 1
-- flowtables --
table inet fw4 {
	flowtable ft {
		hook ingress priority filter
		devices = { lan1, lan2, lan3, lan4, wan }
		flags offload
		counter
	}
}
-- flowtable detail (devices + flags; 'flags offload' means HARDWARE) --
table inet fw4 {
	flowtable ft {
		hook ingress priority filter
		devices = { lan1, lan2, lan3, lan4, wan }
		flags offload
		counter
	}
}
-- DECISIVE: does the flowtable carry 'counter'? --
   (if yes, offloaded flows still update conntrack byte accounting,
    which makes conntrack a viable byte source even under offload)
		devices = { lan1, lan2, lan3, lan4, wan }
		flags offload
		counter
-- the flow add rule --
4:		meta l4proto { tcp, udp } flow add @ft
